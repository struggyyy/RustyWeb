{
  "name": "rustyweb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "check-circular": "madge --circular --extensions ts,tsx --ts-config tsconfig.json .",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run knip && npm run check-circular && npm run test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^12.6.0",
    "i18next": "^25.7.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.554.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "latest",
    "react-dom": "latest",
    "react-i18next": "^16.5.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.22",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^27.3.0",
    "knip": "^6.24.0",
    "madge": "^8.0.0",
    "postcss": "^8.5.10",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.1.17",
    "typescript": "latest",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "protobufjs": "^8.6.3",
    "@protobufjs/utf8": "^1.1.1",
    "vite": "^7.3.5",
    "js-yaml": "^4.1.2",
    "postcss": "^8.5.10",
    "esbuild": "^0.28.1"
  }
}
